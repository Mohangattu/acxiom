@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav ms-auto align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.FullName ?? User.Identity?.Name;
    var userRoles = currentUser != null ? await UserManager.GetRolesAsync(currentUser) : new List<string>();
    var primaryRole = userRoles.FirstOrDefault() ?? "User";

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="badge bg-primary rounded-pill px-2 py-1">@primaryRole</span>
            <strong>@displayName</strong>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userDropdown">
            <li>
                <div class="dropdown-header">
                    <small class="text-muted">Signed in as</small><br />
                    <strong>@User.Identity?.Name</strong>
                </div>
            </li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                    <i class="bi bi-person-circle me-1"></i> My Profile
                </a>
            </li>
            @if (User.IsInRole("Admin"))
            {
                <li>
                    <a class="dropdown-item" asp-controller="Users" asp-action="Index">
                        <i class="bi bi-people me-1"></i> Manage Users
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-controller="AuditLogs" asp-action="Index">
                        <i class="bi bi-journal-text me-1"></i> Audit Logs
                    </a>
                </li>
            }
            <li><hr class="dropdown-divider"></li>
            <li>
                <form class="d-inline" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item text-danger">
                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-controller="Account" asp-action="Login">Sign In</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-sm btn-primary ms-2" asp-controller="Account" asp-action="Register">Get Started</a>
    </li>
}
</ul>
