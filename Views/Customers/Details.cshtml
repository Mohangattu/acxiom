@model Customer
@{
    ViewData["Title"] = $"{Model.Name} - Customer Details";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-action="Index">Customers</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0">@Model.Name</h2>
            <span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(Model.CustomerCode) ? $"CUST-{Model.Id:D4}" : Model.CustomerCode)</span>
            @if (Model.Status == CustomerStatus.Active)
            {
                <span class="badge bg-success-subtle text-success border border-success-subtle">Active Customer</span>
            }
            else if (Model.Status == CustomerStatus.Pending)
            {
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Pending</span>
            }
            else
            {
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
            }
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i> Edit Profile
        </a>
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i> Deactivate
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to List
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Left Column: Customer Details Card -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0">Customer Profile</h5>
            </div>
            <div class="card-body pt-0">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Customer Code:</span>
                        <span class="fw-semibold">@(string.IsNullOrEmpty(Model.CustomerCode) ? $"CUST-{Model.Id:D4}" : Model.CustomerCode)</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Customer Name:</span>
                        <span class="fw-semibold">@Model.Name</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Email:</span>
                        <a href="mailto:@Model.Email" class="fw-semibold text-decoration-none">@Model.Email</a>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Phone:</span>
                        <span class="fw-semibold">@(string.IsNullOrEmpty(Model.Phone) ? "-" : Model.Phone)</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Company Name:</span>
                        <span class="fw-semibold">@(string.IsNullOrEmpty(Model.Company) ? "-" : Model.Company)</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">City:</span>
                        <span class="fw-semibold">@(string.IsNullOrEmpty(Model.City) ? "-" : Model.City)</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">State:</span>
                        <span class="fw-semibold">@(string.IsNullOrEmpty(Model.State) ? "-" : Model.State)</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Address:</span>
                        <span class="fw-semibold text-end">@(string.IsNullOrEmpty(Model.Address) ? "-" : Model.Address)</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Industry:</span>
                        <span class="fw-semibold">@(string.IsNullOrEmpty(Model.Industry) ? "-" : Model.Industry)</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Assigned Sales Rep:</span>
                        <span class="fw-semibold">@(Model.AssignedToUser?.FullName ?? "Unassigned")</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Created By:</span>
                        <span class="fw-semibold">@(string.IsNullOrEmpty(Model.CreatedBy) ? "System" : Model.CreatedBy)</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Created Date:</span>
                        <span class="fw-semibold">@Model.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                    </li>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                            <span class="text-muted">Last Updated:</span>
                            <span class="fw-semibold">@Model.UpdatedAt.Value.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- Right Column: Associated CRM Information -->
    <div class="col-lg-7">
        <!-- Associated Opportunities -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">Associated Opportunities</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.Opportunities == null || !Model.Opportunities.Any())
                {
                    <div class="text-center py-4 text-muted small">
                        <i class="bi bi-briefcase me-1"></i> No opportunities associated with this customer yet.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Title</th>
                                    <th>Stage</th>
                                    <th>Amount</th>
                                    <th>Close Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var opp in Model.Opportunities)
                                {
                                    <tr>
                                        <td class="ps-3 fw-semibold">@opp.Title</td>
                                        <td><span class="badge bg-info text-dark">@opp.Stage</span></td>
                                        <td>$@opp.Amount.ToString("N0")</td>
                                        <td class="small text-muted">@opp.ExpectedCloseDate.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- Associated Follow-Ups -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">Follow-Up History</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.FollowUps == null || !Model.FollowUps.Any())
                {
                    <div class="text-center py-4 text-muted small">
                        <i class="bi bi-clock-history me-1"></i> No follow-up activities recorded for this customer.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Subject</th>
                                    <th>Type</th>
                                    <th>Priority</th>
                                    <th>Status</th>
                                    <th>Due Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in Model.FollowUps)
                                {
                                    <tr>
                                        <td class="ps-3 fw-semibold">@f.Subject</td>
                                        <td>@f.Type</td>
                                        <td><span class="badge bg-secondary">@f.Priority</span></td>
                                        <td><span class="badge bg-light text-dark border">@f.Status</span></td>
                                        <td class="small text-muted">@f.DueDate.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
