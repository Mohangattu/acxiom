@model Customer
@{
    ViewData["Title"] = $"Deactivate Customer - {Model.Name}";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6">
        <div class="card shadow-sm border-warning">
            <div class="card-header bg-warning text-dark py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Customer Deactivation</h5>
            </div>
            <div class="card-body p-4">
                <p class="lead mb-2">Are you sure you want to deactivate this customer account?</p>
                
                <div class="alert alert-info py-2 small mb-3">
                    <i class="bi bi-shield-check me-1"></i> <strong>Safe Deactivation:</strong> This operation marks the customer record as <em>Inactive</em>, preventing future modifications while preserving all historical opportunities and activity logs.
                </div>

                <div class="bg-light p-3 rounded mb-4">
                    <div class="mb-2"><strong>Customer Code:</strong> @(string.IsNullOrEmpty(Model.CustomerCode) ? $"CUST-{Model.Id:D4}" : Model.CustomerCode)</div>
                    <div class="mb-2"><strong>Customer Name:</strong> @Model.Name</div>
                    <div class="mb-2"><strong>Email:</strong> @Model.Email</div>
                    <div class="mb-2"><strong>Phone:</strong> @(string.IsNullOrEmpty(Model.Phone) ? "N/A" : Model.Phone)</div>
                    <div class="mb-2"><strong>Company:</strong> @(Model.Company ?? "N/A")</div>
                    <div class="mb-2"><strong>City / State:</strong> @(string.IsNullOrEmpty(Model.City) ? "-" : Model.City), @(string.IsNullOrEmpty(Model.State) ? "-" : Model.State)</div>
                    <div class="mb-2"><strong>Current Status:</strong> <span class="badge bg-secondary">@Model.Status</span></div>
                    <div class="mb-2"><strong>Assigned To:</strong> @(Model.AssignedToUser?.FullName ?? "Unassigned")</div>
                    <div><strong>Created:</strong> @Model.CreatedAt.ToString("MMM dd, yyyy") by @(string.IsNullOrEmpty(Model.CreatedBy) ? "System" : Model.CreatedBy)</div>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-warning px-4 fw-semibold text-dark">
                            <i class="bi bi-slash-circle me-1"></i> Deactivate Customer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
