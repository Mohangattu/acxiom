@model Lead
@{
    ViewData["Title"] = $"Delete Lead - {Model.FullName}";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i> Delete Lead Confirmation</h5>
            </div>
            <div class="card-body p-4">
                <p class="lead">Are you sure you want to delete this prospect lead?</p>
                
                <div class="bg-light p-3 rounded mb-4">
                    <div class="mb-2"><strong>Lead Code:</strong> <span class="font-monospace">@(Model.LeadCode ?? $"LEAD-{Model.Id:D4}")</span></div>
                    <div class="mb-2"><strong>Lead Name:</strong> @Model.FullName</div>
                    <div class="mb-2"><strong>Email:</strong> @Model.Email</div>
                    <div class="mb-2"><strong>Company:</strong> @(Model.Company ?? "N/A")</div>
                    <div class="mb-2"><strong>Status:</strong> @Model.Status</div>
                    <div class="mb-2"><strong>Assigned To:</strong> @(Model.AssignedToUser?.FullName ?? "Unassigned")</div>
                    <div><strong>Created:</strong> @Model.CreatedAt.ToString("MMM dd, yyyy")</div>
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4 fw-semibold">Delete Lead</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
