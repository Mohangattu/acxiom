@model ConvertLeadViewModel
@{
    ViewData["Title"] = $"Convert Lead: {Model.LeadFullName} - Acxiom CRM";
}

<div class="row justify-content-center my-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-0">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1 small">
                        <li class="breadcrumb-item"><a asp-action="Index">Leads</a></li>
                        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.LeadId">@Model.LeadFullName</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Convert Lead</li>
                    </ol>
                </nav>
                <div class="d-flex align-items-center gap-2">
                    <div class="p-2 bg-success-subtle text-success rounded">
                        <i class="bi bi-arrow-repeat fs-4"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold">Convert Lead to Customer</h4>
                        <small class="text-muted">Create a permanent customer account and optional sales opportunity</small>
                    </div>
                </div>
            </div>

            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2" role="alert">
                        <div asp-validation-summary="All" class="text-danger small mb-0"></div>
                    </div>
                }

                <form asp-action="Convert" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadFullName" />

                    <h5 class="fw-semibold text-primary mb-3">1. New Customer Profile Details</h5>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="CustomerName" class="form-control" />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="Phone" class="form-label fw-semibold"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Company" class="form-label fw-semibold"></label>
                            <input asp-for="Company" class="form-control" />
                            <span asp-validation-for="Company" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Industry" class="form-label fw-semibold"></label>
                            <input asp-for="Industry" class="form-control" placeholder="e.g. Software, Finance" />
                            <span asp-validation-for="Industry" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="AssignedToUserId" class="form-label fw-semibold"></label>
                        <select asp-for="AssignedToUserId" class="form-select" asp-items="ViewBag.AssignedToUserId">
                            <option value="">-- Select Sales Rep --</option>
                        </select>
                        <span asp-validation-for="AssignedToUserId" class="text-danger small"></span>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="fw-semibold text-primary mb-0">2. Sales Opportunity Deal</h5>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="CreateOpportunity" id="createOppSwitch" onchange="toggleOppFields()">
                            <label class="form-check-label fw-semibold" for="createOppSwitch">Create Opportunity</label>
                        </div>
                    </div>

                    <div id="oppFieldsContainer">
                        <div class="mb-3">
                            <label asp-for="OpportunityTitle" class="form-label fw-semibold"></label>
                            <input asp-for="OpportunityTitle" class="form-control" id="oppTitleInput" />
                            <span asp-validation-for="OpportunityTitle" class="text-danger small"></span>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-4">
                                <label asp-for="OpportunityAmount" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="OpportunityAmount" class="form-control" id="oppAmountInput" />
                                </div>
                                <span asp-validation-for="OpportunityAmount" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="OpportunityStage" class="form-label fw-semibold"></label>
                                <select asp-for="OpportunityStage" class="form-select" asp-items="Html.GetEnumSelectList<OpportunityStage>()"></select>
                                <span asp-validation-for="OpportunityStage" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ExpectedCloseDate" class="form-label fw-semibold"></label>
                                <input type="date" asp-for="ExpectedCloseDate" class="form-control" value="@Model.ExpectedCloseDate.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 fw-semibold">
                            <i class="bi bi-check2-circle me-1"></i> Confirm & Convert Lead
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleOppFields() {
            var isChecked = document.getElementById('createOppSwitch').checked;
            var container = document.getElementById('oppFieldsContainer');
            if (isChecked) {
                container.style.display = 'block';
            } else {
                container.style.display = 'none';
            }
        }
    </script>
}
