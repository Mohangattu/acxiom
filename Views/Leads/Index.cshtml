@model IEnumerable<Lead>
@{
    ViewData["Title"] = "Sales Leads - Acxiom CRM";
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var totalItems = (int)ViewBag.TotalItems;
    var searchTerm = ViewBag.SearchTerm as string;
    var statusFilter = ViewBag.StatusFilter as LeadStatus?;
    var companyFilter = ViewBag.CompanyFilter as string;
    var assignedToFilter = ViewBag.AssignedToFilter as string;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Sales Leads</h2>
        <p class="text-muted mb-0">Track prospect inquiries, qualification status, and pipeline conversions</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" class="btn btn-outline-secondary">
            <i class="bi bi-download me-1"></i> Export CSV
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Add Lead
        </a>
    </div>
</div>

<!-- Search & Filters -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="searchTerm" value="@searchTerm" class="form-control border-start-0" placeholder="Search name, email, phone..." />
                </div>
            </div>
            <div class="col-md-3">
                <input type="text" name="companyFilter" value="@companyFilter" class="form-control" placeholder="Filter by company..." />
            </div>
            <div class="col-md-2">
                <select name="statusFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="@LeadStatus.New" selected="@(statusFilter == LeadStatus.New)">New</option>
                    <option value="@LeadStatus.Contacted" selected="@(statusFilter == LeadStatus.Contacted)">Contacted</option>
                    <option value="@LeadStatus.Qualified" selected="@(statusFilter == LeadStatus.Qualified)">Qualified</option>
                    <option value="@LeadStatus.Unqualified" selected="@(statusFilter == LeadStatus.Unqualified)">Unqualified</option>
                    <option value="@LeadStatus.Converted" selected="@(statusFilter == LeadStatus.Converted)">Converted</option>
                    <option value="@LeadStatus.Lost" selected="@(statusFilter == LeadStatus.Lost)">Lost</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="assignedToFilter" asp-items="ViewBag.AssignedToUserId" class="form-select">
                    <option value="">All Assigned Reps</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-3">Filter</button>
                @if (!string.IsNullOrEmpty(searchTerm) || !string.IsNullOrEmpty(companyFilter) || statusFilter.HasValue || !string.IsNullOrEmpty(assignedToFilter))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Lead List Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-funnel text-muted display-4"></i>
                <h5 class="mt-3 text-secondary">No leads found</h5>
                <p class="text-muted small">Try searching with a different term or register a new prospect lead.</p>
                <a asp-action="Create" class="btn btn-sm btn-primary">Add Lead</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Lead Code</th>
                            <th>Lead Name</th>
                            <th>Company</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Source</th>
                            <th>Status</th>
                            <th>Expected Value</th>
                            <th>Assigned Rep</th>
                            <th>Created Date</th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lead in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="badge bg-light text-dark border font-monospace">@(lead.LeadCode ?? $"LEAD-{lead.Id:D4}")</span>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@lead.Id" class="fw-semibold text-decoration-none text-dark">
                                        @lead.FullName
                                    </a>
                                </td>
                                <td>@(string.IsNullOrEmpty(lead.Company) ? "-" : lead.Company)</td>
                                <td><i class="bi bi-envelope me-1 text-muted small"></i>@lead.Email</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(lead.Phone))
                                    {
                                        <small><i class="bi bi-telephone me-1 text-muted small"></i>@lead.Phone</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td><span class="badge bg-light text-secondary border">@(lead.Source ?? "Direct")</span></td>
                                <td>
                                    @switch (lead.Status)
                                    {
                                        case LeadStatus.New:
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">New</span>
                                            break;
                                        case LeadStatus.Contacted:
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Contacted</span>
                                            break;
                                        case LeadStatus.Qualified:
                                            <span class="badge bg-info-subtle text-info border border-info-subtle">Qualified</span>
                                            break;
                                        case LeadStatus.Unqualified:
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Unqualified</span>
                                            break;
                                        case LeadStatus.Converted:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Converted</span>
                                            break;
                                        case LeadStatus.Lost:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Lost</span>
                                            break;
                                    }
                                </td>
                                <td class="fw-bold text-success">
                                    @(lead.EstimatedValue.HasValue ? lead.EstimatedValue.Value.ToString("C0") : "-")
                                </td>
                                <td>
                                    @if (lead.AssignedToUser != null)
                                    {
                                        <span class="small"><i class="bi bi-person me-1 text-muted"></i>@lead.AssignedToUser.FullName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Unassigned</span>
                                    }
                                </td>
                                <td><small class="text-muted">@lead.CreatedAt.ToString("MMM dd, yyyy")</small></td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        @if (lead.Status == LeadStatus.Qualified)
                                        {
                                            <a asp-action="Convert" asp-route-id="@lead.Id" class="btn btn-outline-success" title="Convert to Customer">
                                                <i class="bi bi-arrow-right-circle"></i> Convert
                                            </a>
                                        }
                                        <a asp-action="Details" asp-route-id="@lead.Id" class="btn btn-outline-secondary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (lead.Status != LeadStatus.Converted)
                                        {
                                            <a asp-action="Edit" asp-route-id="@lead.Id" class="btn btn-outline-secondary" title="Edit Lead">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }
                                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@lead.Id" class="btn btn-outline-danger" title="Delete Lead">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="card-footer bg-white border-0 py-3">
                    <nav aria-label="Leads pagination">
                        <ul class="pagination pagination-sm justify-content-center mb-0">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchTerm="@searchTerm" asp-route-statusFilter="@statusFilter" asp-route-companyFilter="@companyFilter" asp-route-assignedToFilter="@assignedToFilter">Previous</a>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(currentPage == i ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchTerm="@searchTerm" asp-route-statusFilter="@statusFilter" asp-route-companyFilter="@companyFilter" asp-route-assignedToFilter="@assignedToFilter">@i</a>
                                </li>
                            }
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchTerm="@searchTerm" asp-route-statusFilter="@statusFilter" asp-route-companyFilter="@companyFilter" asp-route-assignedToFilter="@assignedToFilter">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>
