@model Lead
@{
    ViewData["Title"] = $"{Model.FullName} - Lead Details";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-action="Index">Leads</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.FullName</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0">@Model.FullName</h2>
            <span class="badge bg-light text-dark border font-monospace fs-6">@(Model.LeadCode ?? $"LEAD-{Model.Id:D4}")</span>
            @switch (Model.Status)
            {
                case LeadStatus.New:
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">New</span>
                    break;
                case LeadStatus.Contacted:
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Contacted</span>
                    break;
                case LeadStatus.Qualified:
                    <span class="badge bg-info-subtle text-info border border-info-subtle">Qualified</span>
                    break;
                case LeadStatus.Unqualified:
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Unqualified</span>
                    break;
                case LeadStatus.Converted:
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Converted</span>
                    break;
                case LeadStatus.Lost:
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Lost</span>
                    break;
            }
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status == LeadStatus.Qualified)
        {
            <a asp-action="Convert" asp-route-id="@Model.Id" class="btn btn-success">
                <i class="bi bi-arrow-right-circle me-1"></i> Convert to Customer
            </a>
        }
        @if (Model.Status != LeadStatus.Converted)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                <i class="bi bi-pencil me-1"></i> Edit
            </a>
        }
        else if (Model.ConvertedCustomerId.HasValue)
        {
            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.ConvertedCustomerId" class="btn btn-outline-primary">
                <i class="bi bi-building me-1"></i> View Converted Customer Profile
            </a>
        }
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i> Delete
            </a>
        }
    </div>
</div>

<div class="row g-4">
    <!-- Lead Details -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">Lead Profile</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Lead Code:</span>
                        <span class="fw-bold font-monospace">@(Model.LeadCode ?? $"LEAD-{Model.Id:D4}")</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Lead Name:</span>
                        <span class="fw-semibold">@Model.FullName</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Email:</span>
                        <a href="mailto:@Model.Email" class="fw-semibold text-decoration-none">@Model.Email</a>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Phone:</span>
                        <span class="fw-semibold">@(string.IsNullOrEmpty(Model.Phone) ? "-" : Model.Phone)</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Company:</span>
                        <span class="fw-semibold">@(string.IsNullOrEmpty(Model.Company) ? "-" : Model.Company)</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Lead Source:</span>
                        <span class="badge bg-light text-dark border">@(Model.Source ?? "Direct")</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Expected Value:</span>
                        <span class="fw-bold text-success">@(Model.EstimatedValue.HasValue ? Model.EstimatedValue.Value.ToString("C0") : "-")</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Assigned Sales Rep:</span>
                        <span class="fw-semibold">@(Model.AssignedToUser?.FullName ?? "Unassigned")</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Created Date:</span>
                        <span class="fw-semibold">@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                    </li>
                    @if (Model.ConvertedAt.HasValue)
                    {
                        <li class="list-group-item px-0 py-2 d-flex justify-content-between bg-success-subtle rounded p-2 mt-2">
                            <span class="text-success fw-semibold">Converted On:</span>
                            <span class="text-success fw-bold">@Model.ConvertedAt.Value.ToString("MMM dd, yyyy HH:mm")</span>
                        </li>
                    }
                </ul>

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="mt-3">
                        <label class="fw-semibold small text-muted">Notes / Inquiries:</label>
                        <div class="p-3 bg-light rounded text-secondary small mt-1">@Model.Notes</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right: Activities / Follow-ups -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Follow-Up Tasks & Activities (@Model.FollowUps.Count)</h5>
            </div>
            <div class="card-body p-0">
                @if (!Model.FollowUps.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-calendar-event text-secondary fs-3"></i>
                        <p class="small mt-2 mb-0">No follow-ups recorded for this lead yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Subject</th>
                                    <th>Type</th>
                                    <th>Due Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in Model.FollowUps)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold">@f.Subject</td>
                                        <td><span class="badge bg-light text-dark border">@f.Type</span></td>
                                        <td>@f.DueDate.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            @if (f.Status == FollowUpStatus.Completed)
                                            {
                                                <span class="badge bg-success">Completed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Pending</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
