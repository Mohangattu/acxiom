@model Lead
@{
    ViewData["Title"] = $"Edit {Model.FullName} - Acxiom CRM";
    var isSalesExec = (bool)(ViewBag.IsSalesExecutive ?? false);
}

<div class="row justify-content-center my-4">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-0">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1 small">
                        <li class="breadcrumb-item"><a asp-action="Index">Leads</a></li>
                        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.FullName</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Edit</li>
                    </ol>
                </nav>
                <h4 class="mb-0 fw-bold">Edit Lead: @Model.FullName</h4>
                <small class="text-muted">Lead Code: <strong class="font-monospace">@(Model.LeadCode ?? $"LEAD-{Model.Id:D4}")</strong></small>
            </div>
            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2" role="alert">
                        <div asp-validation-summary="All" class="text-danger small mb-0"></div>
                    </div>
                }

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="LeadCode" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <input type="hidden" asp-for="ConvertedCustomerId" />
                    <input type="hidden" asp-for="ConvertedAt" />

                    <div class="mb-3">
                        <label asp-for="LeadName" class="form-label fw-semibold">Lead Name</label> <span class="text-danger">*</span>
                        <input asp-for="LeadName" class="form-control" value="@Model.FullName" />
                        <span asp-validation-for="LeadName" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Company" class="form-label fw-semibold"></label>
                            <input asp-for="Company" class="form-control" />
                            <span asp-validation-for="Company" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Source" class="form-label fw-semibold"></label>
                            <input asp-for="Source" class="form-control" />
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold"></label>
                            <select asp-for="Status" class="form-select">
                                <option value="1" selected="@(Model.Status == LeadStatus.New)">New</option>
                                <option value="2" selected="@(Model.Status == LeadStatus.Contacted)">Contacted</option>
                                <option value="3" selected="@(Model.Status == LeadStatus.Qualified)">Qualified</option>
                                <option value="4" selected="@(Model.Status == LeadStatus.Unqualified)">Unqualified</option>
                                <option value="6" selected="@(Model.Status == LeadStatus.Lost)">Lost</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="EstimatedValue" class="form-label fw-semibold">Expected Value ($)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="EstimatedValue" class="form-control" type="number" step="0.01" min="0" />
                            </div>
                            <span asp-validation-for="EstimatedValue" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="AssignedToUserId" class="form-label fw-semibold">Assigned Rep</label>
                            @if (isSalesExec)
                            {
                                <input type="hidden" asp-for="AssignedToUserId" />
                                <select class="form-select" asp-items="ViewBag.AssignedToUserId" disabled>
                                </select>
                                <small class="text-muted">Assignment managed by Manager/Admin</small>
                            }
                            else
                            {
                                <select asp-for="AssignedToUserId" class="form-select" asp-items="ViewBag.AssignedToUserId">
                                    <option value="">-- Unassigned --</option>
                                </select>
                            }
                            <span asp-validation-for="AssignedToUserId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
