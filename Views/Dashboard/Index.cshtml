@model DashboardViewModel
@{
    ViewData["Title"] = "CRM Executive Dashboard";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">CRM Executive Dashboard</h2>
        <p class="text-muted mb-0">Overview of sales performance, active opportunities, and upcoming activities</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Leads" asp-action="Create" class="btn btn-outline-primary">
            <i class="bi bi-person-plus me-1"></i> New Lead
        </a>
        <a asp-controller="Opportunities" asp-action="Create" class="btn btn-outline-success">
            <i class="bi bi-graph-up me-1"></i> New Opportunity
        </a>
        <a asp-controller="FollowUps" asp-action="Create" class="btn btn-primary">
            <i class="bi bi-calendar-plus me-1"></i> New Task
        </a>
    </div>
</div>

<!-- 1. Top KPI Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 stat-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Total Customers</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalCustomers</h3>
                    <small class="text-muted"><i class="bi bi-building me-1"></i>Active Accounts</small>
                </div>
                <div class="p-3 bg-primary-subtle text-primary rounded-circle">
                    <i class="bi bi-building fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 stat-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Active Leads</span>
                    <h3 class="fw-bold text-primary mb-0 mt-1">@Model.OpenLeads <small class="fs-6 fw-normal text-muted">/ @Model.TotalLeads total</small></h3>
                    <small class="text-success fw-semibold"><i class="bi bi-check-circle me-1"></i>@Model.ConvertedLeads Converted</small>
                </div>
                <div class="p-3 bg-info-subtle text-info rounded-circle">
                    <i class="bi bi-funnel fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 stat-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Pipeline Volume</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalPipelineValue.ToString("C0")</h3>
                    <small class="text-muted"><i class="bi bi-briefcase me-1"></i>@Model.ActiveOpportunities Active Deals</small>
                </div>
                <div class="p-3 bg-warning-subtle text-warning rounded-circle">
                    <i class="bi bi-graph-up-arrow fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 stat-card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Closed Won Deals</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@Model.WonDealsValue.ToString("C0")</h3>
                    @if (Model.OverdueFollowUpsCount > 0)
                    {
                        <small class="text-danger fw-semibold"><i class="bi bi-exclamation-circle me-1"></i>@Model.OverdueFollowUpsCount Overdue Tasks</small>
                    }
                    else
                    {
                        <small class="text-muted"><i class="bi bi-calendar-check me-1"></i>@Model.PendingFollowUpsCount Pending Tasks</small>
                    }
                </div>
                <div class="p-3 bg-success-subtle text-success rounded-circle">
                    <i class="bi bi-trophy fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 2. Charts Section -->
<div class="row g-4 mb-4">
    <!-- Leads by Status Doughnut Chart -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0">Leads by Status</h5>
                <small class="text-muted">Lead qualification and conversion distribution</small>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div style="max-height: 280px; width: 100%; position: relative;">
                    <canvas id="leadsChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Opportunity Stage Pipeline Bar Chart -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 border-0">
                <h5 class="fw-bold mb-0">Deal Pipeline by Stage ($ Value)</h5>
                <small class="text-muted">Total value of opportunities across each sales stage</small>
            </div>
            <div class="card-body">
                <div style="max-height: 280px; width: 100%; position: relative;">
                    <canvas id="oppsChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 3. Tables Section: Upcoming Tasks & Recent Deals -->
<div class="row g-4 mb-4">
    <!-- Upcoming Follow-Ups -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Upcoming Follow-Up Tasks</h5>
                <a asp-controller="FollowUps" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.UpcomingFollowUps.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-calendar-check text-secondary fs-3"></i>
                        <p class="small mt-2 mb-0">No pending follow-ups scheduled.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Task</th>
                                    <th>Type</th>
                                    <th>Due</th>
                                    <th>Priority</th>
                                    <th class="text-end pe-3">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in Model.UpcomingFollowUps)
                                {
                                    var isOverdue = f.DueDate < DateTime.UtcNow;
                                    <tr>
                                        <td class="ps-3">
                                            <a asp-controller="FollowUps" asp-action="Details" asp-route-id="@f.Id" class="fw-semibold text-decoration-none text-dark">
                                                @f.Subject
                                            </a>
                                            @if (f.Customer != null)
                                            {
                                                <div><small class="text-muted"><i class="bi bi-building me-1"></i>@f.Customer.Name</small></div>
                                            }
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@f.Type</span></td>
                                        <td>
                                            @if (isOverdue)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                    @f.DueDate.ToLocalTime().ToString("MMM dd") (Overdue)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="small">@f.DueDate.ToLocalTime().ToString("MMM dd, hh:mm tt")</span>
                                            }
                                        </td>
                                        <td>
                                            @if (f.Priority == PriorityLevel.Urgent)
                                            {
                                                <span class="badge bg-danger">Urgent</span>
                                            }
                                            else if (f.Priority == PriorityLevel.High)
                                            {
                                                <span class="badge bg-warning text-dark">High</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@f.Priority</span>
                                            }
                                        </td>
                                        <td class="text-end pe-3">
                                            <form asp-controller="FollowUps" asp-action="ToggleComplete" asp-route-id="@f.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Mark Done">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Opportunities -->
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Recent Deals & Opportunities</h5>
                <a asp-controller="Opportunities" asp-action="Index" class="btn btn-sm btn-outline-primary">View Pipeline</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.RecentOpportunities.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-graph-up text-secondary fs-3"></i>
                        <p class="small mt-2 mb-0">No opportunities created yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Opportunity</th>
                                    <th>Customer</th>
                                    <th>Amount</th>
                                    <th>Stage</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var opp in Model.RecentOpportunities)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <a asp-controller="Opportunities" asp-action="Details" asp-route-id="@opp.Id" class="fw-semibold text-decoration-none text-dark">
                                                @opp.Title
                                            </a>
                                        </td>
                                        <td>
                                            @(opp.Customer != null ? opp.Customer.Name : "-")
                                        </td>
                                        <td class="fw-bold text-success">@opp.Amount.ToString("C0")</td>
                                        <td>
                                            <span class="badge @(opp.Stage == OpportunityStage.ClosedWon ? "bg-success" : opp.Stage == OpportunityStage.ClosedLost ? "bg-danger" : "bg-primary")">
                                                @opp.Stage
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- 4. System Audit Activity Stream -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0"><i class="bi bi-activity me-2 text-primary"></i>Recent System Activity</h5>
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a asp-controller="AuditLogs" asp-action="Index" class="btn btn-sm btn-outline-secondary">View Full Audit Trail</a>
        }
    </div>
    <div class="card-body p-0">
        <div class="list-group list-group-flush">
            @foreach (var log in Model.RecentAuditLogs)
            {
                <div class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="badge bg-light text-dark border me-2">@log.EntityName</span>
                        <strong class="text-dark">@log.Action:</strong>
                        <span class="text-secondary ms-1">@log.Details</span>
                    </div>
                    <div class="text-end text-muted small">
                        <div><i class="bi bi-person me-1"></i>@(log.UserName ?? "System")</div>
                        <div>@log.Timestamp.ToLocalTime().ToString("MMM dd, hh:mm tt")</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Leads by Status Chart
            const leadLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusLabels));
            const leadCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusCounts));

            const ctxLeads = document.getElementById('leadsChart').getContext('2d');
            new Chart(ctxLeads, {
                type: 'doughnut',
                data: {
                    labels: leadLabels,
                    datasets: [{
                        data: leadCounts,
                        backgroundColor: [
                            '#3b82f6', // New (Blue)
                            '#f59e0b', // Contacted (Amber)
                            '#6366f1', // Qualified (Indigo)
                            '#ef4444', // Lost (Red)
                            '#10b981'  // Converted (Green)
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                boxWidth: 12,
                                padding: 15
                            }
                        }
                    }
                }
            });

            // 2. Deals by Stage Chart
            const oppLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityStageLabels));
            const oppValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityStageValues));

            const ctxOpps = document.getElementById('oppsChart').getContext('2d');
            new Chart(ctxOpps, {
                type: 'bar',
                data: {
                    labels: oppLabels,
                    datasets: [{
                        label: 'Total Deal Amount ($)',
                        data: oppValues,
                        backgroundColor: [
                            '#38bdf8', // Prospecting
                            '#fbbf24', // Qualification
                            '#a855f7', // Proposal
                            '#fb923c', // Negotiation
                            '#22c55e', // Closed Won
                            '#f87171'  // Closed Lost
                        ],
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return '$' + context.parsed.y.toLocaleString();
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return '$' + value.toLocaleString();
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
}
