@{
    ViewData["Title"] = "Access Denied - Acxiom CRM";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-0 p-5">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-x display-1"></i>
            </div>
            <h2 class="fw-bold mb-2">Access Denied</h2>
            <p class="text-muted mb-4">You do not have sufficient permissions to view or perform operations on this page.</p>
            <div>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4">Return to Dashboard</a>
            </div>
        </div>
    </div>
</div>
