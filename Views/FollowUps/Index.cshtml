@model IEnumerable<FollowUp>
@{
    ViewData["Title"] = "Follow-Ups & Activities - Acxiom CRM";
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var totalItems = (int)ViewBag.TotalItems;
    var searchTerm = ViewBag.SearchTerm as string;
    var statusFilter = ViewBag.StatusFilter as FollowUpStatus?;
    var typeFilter = ViewBag.TypeFilter as FollowUpType?;
    var priorityFilter = ViewBag.PriorityFilter as PriorityLevel?;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Follow-Ups & Tasks</h2>
        <p class="text-muted mb-0">Manage customer follow-ups, calls, meetings, and activity schedules</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" class="btn btn-outline-secondary">
            <i class="bi bi-download me-1"></i> Export CSV
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Add Task
        </a>
    </div>
</div>

<!-- Search & Filters -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="searchTerm" value="@searchTerm" class="form-control border-start-0" placeholder="Search tasks, notes..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="statusFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="@FollowUpStatus.Pending" selected="@(statusFilter == FollowUpStatus.Pending)">Pending</option>
                    <option value="@FollowUpStatus.Completed" selected="@(statusFilter == FollowUpStatus.Completed)">Completed</option>
                    <option value="@FollowUpStatus.Cancelled" selected="@(statusFilter == FollowUpStatus.Cancelled)">Cancelled</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="typeFilter" class="form-select">
                    <option value="">All Types</option>
                    <option value="@FollowUpType.Call" selected="@(typeFilter == FollowUpType.Call)">Call</option>
                    <option value="@FollowUpType.Meeting" selected="@(typeFilter == FollowUpType.Meeting)">Meeting</option>
                    <option value="@FollowUpType.Email" selected="@(typeFilter == FollowUpType.Email)">Email</option>
                    <option value="@FollowUpType.Task" selected="@(typeFilter == FollowUpType.Task)">Task</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="priorityFilter" class="form-select">
                    <option value="">All Priorities</option>
                    <option value="@PriorityLevel.Urgent" selected="@(priorityFilter == PriorityLevel.Urgent)">Urgent</option>
                    <option value="@PriorityLevel.High" selected="@(priorityFilter == PriorityLevel.High)">High</option>
                    <option value="@PriorityLevel.Medium" selected="@(priorityFilter == PriorityLevel.Medium)">Medium</option>
                    <option value="@PriorityLevel.Low" selected="@(priorityFilter == PriorityLevel.Low)">Low</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-3">Filter</button>
                @if (!string.IsNullOrEmpty(searchTerm) || statusFilter.HasValue || typeFilter.HasValue || priorityFilter.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
                <span class="ms-auto align-self-center text-muted small">Total: <strong>@totalItems</strong></span>
            </div>
        </form>
    </div>
</div>

<!-- Follow-Ups List Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar2-check text-muted display-4"></i>
                <h5 class="mt-3 text-secondary">No follow-ups found</h5>
                <p class="text-muted small">Schedule client calls, meetings, or email follow-ups to stay on track.</p>
                <a asp-action="Create" class="btn btn-sm btn-primary">Add Task</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40px;" class="ps-3"></th>
                            <th>Subject / Task</th>
                            <th>Type</th>
                            <th>Related To</th>
                            <th>Due Date</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Assigned To</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model)
                        {
                            var isOverdue = f.Status == FollowUpStatus.Pending && f.DueDate < DateTime.UtcNow;
                            var isToday = f.Status == FollowUpStatus.Pending && f.DueDate.Date == DateTime.UtcNow.Date;

                            <tr class="@(f.Status == FollowUpStatus.Completed ? "opacity-75 bg-light" : "")">
                                <td class="ps-3">
                                    <form asp-action="ToggleComplete" asp-route-id="@f.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-link p-0 text-decoration-none" title="@(f.Status == FollowUpStatus.Completed ? "Mark as Pending" : "Mark as Completed")">
                                            @if (f.Status == FollowUpStatus.Completed)
                                            {
                                                <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-circle text-muted fs-5"></i>
                                            }
                                        </button>
                                    </form>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@f.Id" class="fw-semibold text-decoration-none @(f.Status == FollowUpStatus.Completed ? "text-decoration-line-through text-muted" : "text-dark")">
                                        @f.Subject
                                    </a>
                                </td>
                                <td>
                                    @if (f.Type == FollowUpType.Call)
                                    {
                                        <span class="badge bg-primary-subtle text-primary"><i class="bi bi-telephone me-1"></i>Call</span>
                                    }
                                    else if (f.Type == FollowUpType.Meeting)
                                    {
                                        <span class="badge bg-success-subtle text-success"><i class="bi bi-camera-video me-1"></i>Meeting</span>
                                    }
                                    else if (f.Type == FollowUpType.Email)
                                    {
                                        <span class="badge bg-info-subtle text-info"><i class="bi bi-envelope me-1"></i>Email</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary"><i class="bi bi-check-square me-1"></i>Task</span>
                                    }
                                </td>
                                <td>
                                    @if (f.Customer != null)
                                    {
                                        <span class="small"><i class="bi bi-building me-1 text-muted"></i>@f.Customer.Name</span>
                                    }
                                    else if (f.Lead != null)
                                    {
                                        <span class="small"><i class="bi bi-funnel me-1 text-muted"></i>@f.Lead.FullName</span>
                                    }
                                    else if (f.Opportunity != null)
                                    {
                                        <span class="small"><i class="bi bi-graph-up me-1 text-muted"></i>@f.Opportunity.Title</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    <div>@f.DueDate.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                    @if (isOverdue)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">Overdue</span>
                                    }
                                    else if (isToday)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle small">Today</span>
                                    }
                                    else
                                    {
                                        <small class="text-muted">@f.DueDate.ToLocalTime().ToString("hh:mm tt")</small>
                                    }
                                </td>
                                <td>
                                    @if (f.Priority == PriorityLevel.Urgent)
                                    {
                                        <span class="badge bg-danger">Urgent</span>
                                    }
                                    else if (f.Priority == PriorityLevel.High)
                                    {
                                        <span class="badge bg-warning text-dark">High</span>
                                    }
                                    else if (f.Priority == PriorityLevel.Medium)
                                    {
                                        <span class="badge bg-info text-dark">Medium</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">Low</span>
                                    }
                                </td>
                                <td>
                                    @if (f.Status == FollowUpStatus.Completed)
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                    else if (f.Status == FollowUpStatus.Cancelled)
                                    {
                                        <span class="badge bg-secondary">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                </td>
                                <td>
                                    <span class="small text-muted">@(f.AssignedToUser?.FullName ?? "Unassigned")</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@f.Id" class="btn btn-outline-secondary" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-outline-secondary" title="Edit Task">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@f.Id" class="btn btn-outline-danger" title="Delete Task">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="card-footer bg-white border-0 py-3">
                    <nav aria-label="Follow-ups pagination">
                        <ul class="pagination pagination-sm justify-content-center mb-0">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchTerm="@searchTerm" asp-route-statusFilter="@statusFilter">Previous</a>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(currentPage == i ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchTerm="@searchTerm" asp-route-statusFilter="@statusFilter">@i</a>
                                </li>
                            }
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchTerm="@searchTerm" asp-route-statusFilter="@statusFilter">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>
