@model Opportunity
@{
    ViewData["Title"] = $"{Model.Title} - Opportunity Details";
    var stages = new[] { OpportunityStage.Qualification, OpportunityStage.Proposal, OpportunityStage.Negotiation, OpportunityStage.ClosedWon };
    var isSalesExecutive = ViewBag.IsSalesExecutive as bool? ?? false;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-action="Index">Opportunities</a></li>
                <li class="breadcrumb-item active" aria-current="page">@(Model.OpportunityCode ?? $"OPP-{Model.Id:D4}")</li>
            </ol>
        </nav>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-secondary font-monospace fs-6">@(Model.OpportunityCode ?? $"OPP-{Model.Id:D4}")</span>
            <h2 class="fw-bold mb-0">@Model.Title</h2>
            <span class="fs-4 fw-bold text-success ms-2">@Model.Amount.ToString("C0")</span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.Id" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-primary">
            <i class="bi bi-calendar-plus me-1"></i> Add Follow-Up
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i> Edit Deal
        </a>
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i> Delete
            </a>
        }
    </div>
</div>

<!-- Pipeline Stage Stepper -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold text-muted text-uppercase small mb-0">Sales Pipeline Progression</h6>
            <span class="small text-muted">Click any stage to advance this opportunity</span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var stage in stages)
            {
                var isCurrent = Model.Stage == stage;
                var isPast = (int)Model.Stage > (int)stage && Model.Stage != OpportunityStage.ClosedLost;

                <form asp-action="UpdateStage" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <input type="hidden" name="newStage" value="@stage" />
                    <button type="submit" class="btn btn-sm @(isCurrent ? "btn-primary shadow-sm fw-bold" : isPast ? "btn-success-subtle text-success border border-success-subtle" : "btn-light text-muted border")" 
                            title="Move to @stage">
                        @if (isPast)
                        {
                            <i class="bi bi-check-circle-fill me-1"></i>
                        }
                        else if (isCurrent)
                        {
                            <i class="bi bi-arrow-right-circle-fill me-1"></i>
                        }
                        @(stage == OpportunityStage.ClosedWon ? "Won" : stage.ToString())
                    </button>
                </form>
            }

            <!-- Closed Lost Button -->
            <button type="button" class="btn btn-sm @(Model.Stage == OpportunityStage.ClosedLost ? "btn-danger shadow-sm fw-bold" : "btn-outline-danger") ms-auto" 
                    data-bs-toggle="collapse" data-bs-target="#lostReasonForm">
                <i class="bi bi-x-circle me-1"></i> Lost
            </button>
        </div>

        <!-- Optional Win/Loss Reason Collapse Form -->
        <div class="collapse mt-3 @(Model.Stage == OpportunityStage.ClosedLost && string.IsNullOrEmpty(Model.WinLossReason) ? "show" : "")" id="lostReasonForm">
            <div class="p-3 bg-light rounded border">
                <form asp-action="UpdateStage" asp-route-id="@Model.Id" method="post">
                    <input type="hidden" name="newStage" value="@OpportunityStage.ClosedLost" />
                    <label class="form-label small fw-semibold text-danger">Mark as Closed Lost — Specify Win/Loss Reason:</label>
                    <div class="input-group">
                        <input type="text" name="winLossReason" class="form-control form-control-sm" placeholder="e.g. Price too high, chosen competitor, postponed decision..." value="@Model.WinLossReason" />
                        <button type="submit" class="btn btn-sm btn-danger">Confirm Lost</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Deal Summary -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="fw-bold mb-0">Deal Summary</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Opportunity Code:</span>
                        <span class="fw-bold font-monospace">@(Model.OpportunityCode ?? $"OPP-{Model.Id:D4}")</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Customer Organization:</span>
                        @if (Model.Customer != null)
                        {
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="fw-semibold text-decoration-none">
                                @Model.Customer.Name
                            </a>
                        }
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Deal Value:</span>
                        <span class="fw-bold text-success fs-5">@Model.Amount.ToString("C0")</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Weighted Pipeline Value:</span>
                        <span class="fw-semibold text-info">@Model.WeightedValue.ToString("C0")</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Current Stage:</span>
                        <span class="badge @(Model.Stage == OpportunityStage.ClosedWon ? "bg-success" : Model.Stage == OpportunityStage.ClosedLost ? "bg-danger" : "bg-primary")">
                            @(Model.Stage == OpportunityStage.ClosedWon ? "Won" : Model.Stage == OpportunityStage.ClosedLost ? "Lost" : Model.Stage.ToString())
                        </span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Win Probability:</span>
                        <span class="fw-semibold">@Model.Probability%</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Expected Close Date:</span>
                        <span class="fw-semibold @(Model.ExpectedCloseDate.Date < DateTime.UtcNow.Date && Model.Stage != OpportunityStage.ClosedWon && Model.Stage != OpportunityStage.ClosedLost ? "text-danger" : "")">
                            @Model.ExpectedCloseDate.ToString("MMMM dd, yyyy")
                        </span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Assigned Owner:</span>
                        <span class="fw-semibold">@(Model.AssignedToUser?.FullName ?? "Unassigned")</span>
                    </li>
                    @if (!string.IsNullOrEmpty(Model.Source))
                    {
                        <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                            <span class="text-muted">Source:</span>
                            <span>@Model.Source</span>
                        </li>
                    }
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Created By:</span>
                        <span>@(Model.CreatedBy ?? "System")</span>
                    </li>
                    <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                        <span class="text-muted">Created Date:</span>
                        <span>@Model.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy")</span>
                    </li>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <li class="list-group-item px-0 py-2 d-flex justify-content-between">
                            <span class="text-muted">Last Updated:</span>
                            <span>@Model.UpdatedAt.Value.ToLocalTime().ToString("MMM dd, yyyy")</span>
                        </li>
                    }
                </ul>

                @if (!string.IsNullOrEmpty(Model.WinLossReason))
                {
                    <div class="mt-3 p-3 bg-danger-subtle text-danger rounded border border-danger-subtle">
                        <strong class="small d-block"><i class="bi bi-info-circle me-1"></i> Win / Loss Reason:</strong>
                        <span class="small">@Model.WinLossReason</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="mt-3">
                        <label class="fw-semibold small text-muted">Deal Notes:</label>
                        <div class="p-3 bg-light rounded text-secondary small mt-1">@Model.Notes</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Associated Follow-Ups -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Follow-Up Activities & Tasks (@Model.FollowUps.Count)</h5>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@Model.Id" asp-route-customerId="@Model.CustomerId" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus-lg me-1"></i> Add Task
                </a>
            </div>
            <div class="card-body p-0">
                @if (!Model.FollowUps.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-calendar-event text-secondary fs-3"></i>
                        <p class="small mt-2 mb-0">No follow-ups recorded for this deal yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Subject</th>
                                    <th>Type</th>
                                    <th>Due Date</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var f in Model.FollowUps)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold">@f.Subject</td>
                                        <td><span class="badge bg-light text-dark border">@f.Type</span></td>
                                        <td>@f.DueDate.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                        <td>
                                            @if (f.Status == FollowUpStatus.Completed)
                                            {
                                                <span class="badge bg-success">Completed</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Planned</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <a asp-controller="FollowUps" asp-action="Details" asp-route-id="@f.Id" class="btn btn-sm btn-outline-secondary">View</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
