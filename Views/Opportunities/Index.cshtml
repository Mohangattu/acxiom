@model IEnumerable<Opportunity>
@{
    ViewData["Title"] = "Opportunities & Pipeline - Acxiom CRM";
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
    var totalItems = (int)ViewBag.TotalItems;
    var searchTerm = ViewBag.SearchTerm as string;
    var stageFilter = ViewBag.StageFilter as OpportunityStage?;
    var customerId = ViewBag.CustomerId as int?;
    var assignedToFilter = ViewBag.AssignedToFilter as string;
    var totalPipeline = (decimal)ViewBag.TotalPipeline;
    var weightedPipeline = (decimal)ViewBag.WeightedPipeline;
    var wonRevenue = (decimal)ViewBag.WonRevenue;
    var winRatio = (decimal)ViewBag.WinRatio;
    var isSalesExecutive = (bool)ViewBag.IsSalesExecutive;
    var usersList = ViewBag.UsersList as List<ApplicationUser> ?? new List<ApplicationUser>();
    var customersList = ViewBag.CustomersList as List<Customer> ?? new List<Customer>();
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-graph-up-arrow text-primary me-2"></i>Opportunities & Deals</h2>
        <p class="text-muted mb-0">Track revenue pipeline, negotiation stages, and win rates</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" class="btn btn-outline-secondary">
            <i class="bi bi-download me-1"></i> Export CSV
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Add Opportunity
        </a>
    </div>
</div>

<!-- Pipeline KPI Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm border-0 stat-card p-3">
            <span class="text-muted small fw-semibold">Active Pipeline</span>
            <h4 class="fw-bold text-primary mb-0 mt-1">@totalPipeline.ToString("C0")</h4>
            <span class="text-muted small">Gross active deal value</span>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm border-0 stat-card p-3">
            <span class="text-muted small fw-semibold">Weighted Pipeline</span>
            <h4 class="fw-bold text-info mb-0 mt-1">@weightedPipeline.ToString("C0")</h4>
            <span class="text-muted small">Probability-adjusted projection</span>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm border-0 stat-card p-3">
            <span class="text-muted small fw-semibold">Closed Won Revenue</span>
            <h4 class="fw-bold text-success mb-0 mt-1">@wonRevenue.ToString("C0")</h4>
            <span class="text-muted small">Secured contract value</span>
        </div>
    </div>
    <div class="col-md-6 col-lg-3">
        <div class="card shadow-sm border-0 stat-card p-3">
            <span class="text-muted small fw-semibold">Win Ratio</span>
            <h4 class="fw-bold text-dark mb-0 mt-1">@winRatio.ToString("N1")%</h4>
            <span class="text-muted small">Total tracked: @totalItems deals</span>
        </div>
    </div>
</div>

<!-- Search & Filters -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="searchTerm" value="@searchTerm" class="form-control border-start-0" placeholder="Search by title, code, or customer..." />
                </div>
            </div>
            <div class="col-md-2">
                <select name="stageFilter" class="form-select">
                    <option value="">All Stages</option>
                    <option value="@OpportunityStage.Qualification" selected="@(stageFilter == OpportunityStage.Qualification)">Qualification</option>
                    <option value="@OpportunityStage.Proposal" selected="@(stageFilter == OpportunityStage.Proposal)">Proposal</option>
                    <option value="@OpportunityStage.Negotiation" selected="@(stageFilter == OpportunityStage.Negotiation)">Negotiation</option>
                    <option value="@OpportunityStage.ClosedWon" selected="@(stageFilter == OpportunityStage.ClosedWon)">Won</option>
                    <option value="@OpportunityStage.ClosedLost" selected="@(stageFilter == OpportunityStage.ClosedLost)">Lost</option>
                    <option value="@OpportunityStage.Prospecting" selected="@(stageFilter == OpportunityStage.Prospecting)">Prospecting</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="customerId" class="form-select">
                    <option value="">All Customers</option>
                    @foreach (var c in customersList)
                    {
                        <option value="@c.Id" selected="@(customerId == c.Id)">@c.Name</option>
                    }
                </select>
            </div>
            @if (!isSalesExecutive)
            {
                <div class="col-md-2">
                    <select name="assignedToFilter" class="form-select">
                        <option value="">All Sales Reps</option>
                        @foreach (var u in usersList)
                        {
                            <option value="@u.Id" selected="@(assignedToFilter == u.Id)">@u.FullName</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md d-flex gap-2">
                <button type="submit" class="btn btn-primary px-3">Filter</button>
                @if (!string.IsNullOrEmpty(searchTerm) || stageFilter.HasValue || customerId.HasValue || !string.IsNullOrEmpty(assignedToFilter))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-graph-up-arrow text-muted display-4"></i>
                <h5 class="mt-3 text-secondary">No opportunities found</h5>
                <p class="text-muted small">Try modifying your filter or create a new deal.</p>
                <a asp-action="Create" class="btn btn-sm btn-primary">Add Opportunity</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Code</th>
                            <th>Deal Title</th>
                            <th>Customer</th>
                            <th>Amount</th>
                            <th>Weighted</th>
                            <th>Stage</th>
                            <th>Probability</th>
                            <th>Expected Close</th>
                            <th>Owner</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var opp in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-secondary font-monospace">@(opp.OpportunityCode ?? $"OPP-{opp.Id:D4}")</span>
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@opp.Id" class="fw-semibold text-decoration-none text-dark">
                                        @opp.Title
                                    </a>
                                </td>
                                <td>
                                    @if (opp.Customer != null)
                                    {
                                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@opp.CustomerId" class="text-decoration-none">
                                            @opp.Customer.Name
                                        </a>
                                    }
                                </td>
                                <td class="fw-bold text-success">@opp.Amount.ToString("C0")</td>
                                <td class="text-muted small fw-semibold">@opp.WeightedValue.ToString("C0")</td>
                                <td>
                                    @if (opp.Stage == OpportunityStage.Prospecting)
                                    {
                                        <span class="badge bg-secondary">Prospecting</span>
                                    }
                                    else if (opp.Stage == OpportunityStage.Qualification)
                                    {
                                        <span class="badge bg-info text-dark">Qualification</span>
                                    }
                                    else if (opp.Stage == OpportunityStage.Proposal)
                                    {
                                        <span class="badge bg-primary">Proposal</span>
                                    }
                                    else if (opp.Stage == OpportunityStage.Negotiation)
                                    {
                                        <span class="badge bg-warning text-dark">Negotiation</span>
                                    }
                                    else if (opp.Stage == OpportunityStage.ClosedWon)
                                    {
                                        <span class="badge bg-success">Won</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Lost</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 6px; width: 50px;">
                                            <div class="progress-bar @(opp.Probability >= 80 ? "bg-success" : opp.Probability >= 40 ? "bg-primary" : "bg-warning")" 
                                                 role="progressbar" style="width: @opp.Probability%"></div>
                                        </div>
                                        <small class="text-muted">@opp.Probability%</small>
                                    </div>
                                </td>
                                <td>
                                    <span class="small @(opp.ExpectedCloseDate.Date < DateTime.UtcNow.Date && opp.Stage != OpportunityStage.ClosedWon && opp.Stage != OpportunityStage.ClosedLost ? "text-danger fw-semibold" : "")">
                                        @opp.ExpectedCloseDate.ToString("MMM dd, yyyy")
                                    </span>
                                </td>
                                <td>
                                    @if (opp.AssignedToUser != null)
                                    {
                                        <span class="small"><i class="bi bi-person me-1 text-muted"></i>@opp.AssignedToUser.FullName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Unassigned</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@opp.Id" class="btn btn-outline-secondary" title="View Deal">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@opp.Id" class="btn btn-outline-secondary" title="Edit Deal">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@opp.Id" class="btn btn-outline-danger" title="Delete Deal">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="card-footer bg-white border-0 py-3">
                    <nav aria-label="Opportunities pagination">
                        <ul class="pagination pagination-sm justify-content-center mb-0">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchTerm="@searchTerm" asp-route-stageFilter="@stageFilter" asp-route-customerId="@customerId" asp-route-assignedToFilter="@assignedToFilter">Previous</a>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(currentPage == i ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchTerm="@searchTerm" asp-route-stageFilter="@stageFilter" asp-route-customerId="@customerId" asp-route-assignedToFilter="@assignedToFilter">@i</a>
                                </li>
                            }
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchTerm="@searchTerm" asp-route-stageFilter="@stageFilter" asp-route-customerId="@customerId" asp-route-assignedToFilter="@assignedToFilter">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>
